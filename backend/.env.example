# EVO Backend — Environment Variables Example
# Copy this file to .env and fill in your values

PORT=5000

# PostgreSQL Connection:
# For cloud deployment on Render (IPv4), use Supabase Connection Pooler:
DATABASE_URL=postgresql://postgres.<project_ref>:your_password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Google Gemini AI (optional — enables real AI responses)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_REQUEST_TIMEOUT_MS=12000

# CORS — comma separated list of allowed frontend origins
CORS_ORIGIN=*

# OAuth resource URL advertised to remote MCP clients such as Gemini.
# Local development default: http://localhost:5000/mcp
# Production must use the public HTTPS MCP endpoint, e.g. https://your-host/mcp
EVO_MCP_PUBLIC_URL=http://localhost:5000/mcp

# Owner login used by the OAuth approval page and the EVO web app
EVO_MASTER_PASSCODE=replace-with-a-private-passcode
EVO_AUTH_SECRET=replace-with-a-long-random-secret
EVO_MCP_TOKEN=replace-with-a-separate-random-secret-for-the-local-stdio-bridge
