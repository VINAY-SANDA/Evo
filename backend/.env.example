# EVO Backend — Environment Variables Example
# Copy this file to .env and fill in your values

PORT=5000

# PostgreSQL Connection (optional — app works without DB using in-memory data)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evo_db

# Google Gemini AI (optional — enables real AI responses)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS — comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
